# =============================================================================
# TRACE — Root .gitignore
# Covers the full monorepo: trace-frontend/, trace-backend/, data/, gemini-test/
# =============================================================================

# ── Secrets and credentials ───────────────────────────────────────────────
.env
.env.*
!**/.env.example

# Firebase service-account JSON (both naming variants)
serviceAccountKey.json
serviceAccountKey.json.json
*.json.json
*service_account*.json
*serviceAccount*.json
firebase-adminsdk*.json
firebase_adminsdk*.json

# Generic private-key and secrets patterns
*.pem
*.key
*.p12
*.pfx
keys.txt
secrets.txt

# ── Experimental / throwaway directories ─────────────────────────────────
gemini-test/

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
*/node_modules/
dist/
dist-ssr/
*/dist/
.cache/
*/.cache/
.vite/
*/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# ── Python / Backend ──────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak

# pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# mypy / type checking
.mypy_cache/
.dmypy.json

# ── Raw data — large, not needed at runtime ───────────────────────────────
data/pvdaq_raw/

# ── Backend local debug and seed scripts (not production code) ───────────
trace-backend/backend_log.txt
trace-backend/debug_*.py
trace-backend/fix_*.py
trace-backend/check_*.py
trace-backend/find_*.py
trace-backend/inspect_*.py
trace-backend/final_check.py
trace-backend/seed_*.py
trace-backend/update_*.py
trace-backend/verify_*.py
trace-backend/test_*.py

# ── IDE and editor ────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── OS generated ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
