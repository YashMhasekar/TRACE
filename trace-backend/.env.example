# trace-backend/.env.example
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=TRACE-Cluster
MONGODB_DATABASE=trace_db

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Use Strategy A for local development OR Strategy B for cloud hosting.
# Strategy A takes priority when FIREBASE_SERVICE_ACCOUNT_PATH is set.

# Strategy A — service-account JSON file (local dev only).
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Use a path local to your machine; never commit the JSON file itself.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Strategy B — individual credential fields (recommended for CI / cloud hosting).
# Uncomment the three lines below and leave FIREBASE_SERVICE_ACCOUNT_PATH unset.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
#
# The private key must be a single-line string with literal \n for newlines.
# Copy the value of "private_key" from your service-account JSON, keeping the quotes.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of production frontend origins to allow.
# Localhost origins are always included automatically.
# Example: ALLOWED_ORIGINS=https://trace.netlify.app,https://www.trace.netlify.app
ALLOWED_ORIGINS=

# ── Groq AI (TRACE AI Investigator) ──────────────────────────────────────────
# Get your API key from: https://console.groq.com
# The AI Investigator returns a 503 stub response when this is not set.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional overrides (defaults shown):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_TOKENS=1500
# GROQ_TEMPERATURE=0.2
